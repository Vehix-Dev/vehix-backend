<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/overlay_background"
    android:padding="8dp"
    android:elevation="8dp">

    <!-- Main Icon Container -->
    <LinearLayout
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/overlay_icon_background">

        <!-- Vehix Icon -->
        <ImageView
            android:id="@+id/vehix_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_vehix"
            android:contentDescription="Vehix Icon" />

        <!-- Status Indicator -->
        <ImageView
            android:id="@+id/status_indicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/ic_online"
            android:contentDescription="Status Indicator" />

    </LinearLayout>

    <!-- Status Text -->
    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Online"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/online_green"
        android:gravity="center"
        android:fontFamily="sans-serif-medium" />

    <!-- Alert Indicator (Initially Hidden) -->
    <ImageView
        android:id="@+id/alert_indicator"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/ic_alert"
        android:visibility="gone"
        android:contentDescription="Alert Indicator" />

</LinearLayout>
